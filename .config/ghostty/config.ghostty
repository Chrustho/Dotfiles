
# --- Theme ---
# Tema integrato in Ghostty
theme = Kanagawa Dragon

# --- Environment Variables ---
env = TERM=xterm-256color

# --- Base Font ---
font-family = "IosevkaTerm Nerd Font"
font-size = 16
font-style = "SemiBold"

# --- Bold Font ---
font-family-bold = "IosevkaTerm Nerd Font Mono"
font-style-bold = "Heavy"

# --- Italic Font ---
font-family-italic = "IosevkaTerm Nerd Font Mono"
font-style-italic = "SemiBold Italic"

# --- Bold Italic Font ---
font-family-bold-italic = "IosevkaTerm Nerd Font Mono"
font-style-bold-italic = "Bold Italic"

# --- Offsets & Spacing ---
adjust-cell-height = 2
adjust-font-baseline = 1

shell-integration-features = no-cursor
cursor-style = block
cursor-color = a6e3a1
cursor-text = 1e1e2e

confirm-close-surface = false

custom-shader = ./shaders/tft.glsl
custom-shader = ./shaders/cursors_warp.glsl
custom-shader-animation = always
