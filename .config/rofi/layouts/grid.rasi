/* Rofi layout: GRID (app-drawer, griglia di icone) */

@import "colors.rasi"

configuration {
    modi: "drun,run";
    font: "IosevkaTerm Nerd Font 13";
    show-icons: true;
    icon-theme: "Neuwaita";
    display-drun: " ";
    display-run: " ";
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: @fg-light;
}

window {
    transparency: "real";
    fullscreen: true;
    background-color: @window-bg;
    border: 0px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    children: [ dummy, wrapper, dummy ];
}

dummy { expand: true; }

wrapper {
    orientation: vertical;
    expand: false;
    margin: 0px calc(50% - 430px);
    background-color: @base-bg;
    border: 2px solid;
    border-color: @accent;
    border-radius: 24px;
    padding: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    padding: 18px 24px;
    spacing: 14px;
    border-radius: 22px 22px 0px 0px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "IosevkaTerm Nerd Font Bold 16";
    vertical-align: 0.5;
}

entry {
    placeholder: "Cerca un'applicazione...";
    placeholder-color: @muted;
    text-color: @fg-light;
    vertical-align: 0.5;
}

listview {
    background-color: @bg;
    padding: 20px;
    columns: 5;
    lines: 4;
    spacing: 12px;
    scrollbar: false;
    fixed-height: true;
    border-radius: 0px 0px 22px 22px;
}

element {
    orientation: vertical;
    padding: 14px 8px;
    spacing: 8px;
    border-radius: 16px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

element selected.normal, element selected.active {
    background-color: @accent;
    text-color: @fg-dark;
}

element-icon {
    size: 48px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
}
