/* Rofi: cheatsheet keybinds (lista monospace ricercabile) */

@import "colors.rasi"

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: @fg-light;
    font: "IosevkaTerm Nerd Font 12";
}

window {
    transparency: "real";
    fullscreen: true;
    background-color: @window-bg;
    border: 0px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    children: [ dummy, wrapper, dummy ];
}

dummy { expand: true; }

wrapper {
    orientation: vertical;
    expand: false;
    margin: 0px calc(50% - 440px);
    background-color: @base-bg;
    border: 3px solid;
    border-color: @accent;
    padding: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    padding: 14px 20px;
    spacing: 14px;
    border: 0px 0px 2px 0px solid;
    border-color: @base-bg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "IosevkaTerm Nerd Font Bold 15";
    vertical-align: 0.5;
}

entry {
    placeholder: "Filtra scorciatoie...";
    placeholder-color: @muted;
    vertical-align: 0.5;
}

listview {
    columns: 2;
    lines: 16;
    spacing: 2px;
    padding: 12px;
    scrollbar: true;
    fixed-height: true;
}

scrollbar {
    handle-width: 4px;
    handle-color: @accent;
    background-color: @bg-alt;
}

element {
    padding: 6px 12px;
    border-radius: 6px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @accent;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
}
