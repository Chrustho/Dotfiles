/* Rofi layout: SPOTLIGHT (barra in alto + dropdown) */

@import "colors.rasi"

configuration {
    modi: "drun,run";
    font: "IosevkaTerm Nerd Font 14";
    show-icons: true;
    icon-theme: "Neuwaita";
    display-drun: " ";
    display-run: " ";
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: @fg-light;
}

window {
    transparency: "real";
    fullscreen: true;
    background-color: @window-bg;
    border: 0px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    children: [ wrapper, dummy ];
}

dummy { expand: true; }

wrapper {
    orientation: vertical;
    expand: false;
    margin: 90px calc(50% - 320px) 0px calc(50% - 320px);
    background-color: transparent;
    border: 0px;
    padding: 0px;
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    padding: 16px 22px;
    spacing: 14px;
    border: 2px solid;
    border-color: @accent;
    border-radius: 18px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "IosevkaTerm Nerd Font Bold 16";
    vertical-align: 0.5;
}

entry {
    placeholder: "Cerca un'applicazione...";
    placeholder-color: @muted;
    text-color: @fg-light;
    vertical-align: 0.5;
}

listview {
    background-color: @base-bg;
    border: 2px solid;
    border-color: @bg-alt;
    border-radius: 18px;
    padding: 10px;
    columns: 1;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
    fixed-height: true;
}

element {
    padding: 10px 14px;
    spacing: 14px;
    border-radius: 12px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

element selected.normal, element selected.active {
    background-color: @accent;
    text-color: @fg-dark;
}

element-icon {
    size: 28px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
}
