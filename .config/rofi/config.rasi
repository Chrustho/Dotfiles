/* =========================================================
   Tema Rofi - Gruvbox Material Moderno (Overlay)
   Ispirato alla tua Waybar
   ========================================================= */

configuration {
    modi: "drun,run";
    font: "IosevkaTerm Nerd Font 14"; 
    show-icons: true;
    icon-theme: "Neuwaita";
    
    /* Icone carine per i prompt ispirate alla tua barra */
    display-drun: " "; 
    display-run: " ";
    drun-display-format: "{name}";
    
    /* Comportamento moderno: seleziona al passaggio del mouse */
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    /* --- Palette Gruvbox Material (dal tuo style.css) --- */
    bg:          #282828; /* Sfondo principale lista */
    bg-alt:      #32302f; /* Sfondo ricerca / selezione */
    base-bg:     #1d2021; /* Sfondo scuro assoluto per i bordi */
    fg-light:    #ddc7a1; /* Testo principale */
    fg-dark:     #282828; 
    
    /* Accenti */
    red:         #ea6962;
    orange:      #e78a4e;
    yellow:      #d8a657;
    green:       #a9b665;
    aqua:        #89b482;
    blue:        #7daea3;
    purple:      #d3869b;

    background-color: transparent;
    text-color: @fg-light;
}

/* --- Finestra a Schermo Intero (Effetto Sfondo Scuro) --- */
window {
    transparency: "real";
    fullscreen: true;
    
    /* a6 = ~65% di opacità. Meno scuro rispetto al Powermenu, 
       così vedi bene le finestre dietro ma senza distrazioni */
    background-color: #1d2021a6; 
    
    border: 0px;
    padding: 0px;
}

/* --- Contenitore Principale Invisibile --- */
mainbox {
    background-color: transparent;
    /* Usiamo i dummy sopra e sotto per schiacciare il launcher al centro in verticale */
    children: [ dummy, wrapper, dummy ];
}

dummy {
    expand: true;
}

/* --- Il vero box del launcher --- */
wrapper {
    orientation: vertical;
    expand: false; /* Non allungarsi più del necessario in verticale */
    
    /* Magia Matematica: Il margine laterale calcola (50% dello schermo - 375px), 
       lasciando al centro un menu largo ESATTAMENTE 750px! */
    margin: 0px calc(50% - 375px);
    
    background-color: @base-bg;
    border: 4px solid;
    border-color: @orange; 
    border-radius: 0px;   
    padding: 0px;
    
    children: [ inputbar, listview ];
}

/* --- Barra di Ricerca (Header) --- */
inputbar {
    background-color: @bg-alt;
    padding: 20px 25px;
    spacing: 15px;
    border-bottom: 2px solid;
    border-color: @base-bg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @blue; /* Blu, come il modulo launcher della tua Waybar */
    font: "IosevkaTerm Nerd Font Bold 16";
    vertical-align: 0.5;
}

entry {
    placeholder: "Cerca un'applicazione...";
    placeholder-color: #7c6f64; /* Un grigio neutro Gruvbox per il placeholder */
    text-color: @fg-light;
    vertical-align: 0.5;
    font: "IosevkaTerm Nerd Font 14";
}

/* --- Lista dei Risultati --- */
listview {
    background-color: @bg;
    padding: 15px;
    columns: 2; /* Layout a griglia a due colonne! */
    lines: 7;   /* Mostra 14 app in totale per schermata */
    spacing: 10px;
    scrollbar: false;
    fixed-height: true;
}

/* --- Singolo Elemento (App/Risultato) --- */
element {
    padding: 10px 15px;
    spacing: 15px;
    border-radius: 0px; /* App in piccoli "bottoni" arrotondati */
}

/* Stato Normale */
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

/* Stato Selezionato */
element selected.normal, element selected.active {
    background-color: @bg-alt;
    text-color: @yellow; /* Testo giallo per risaltare */
    border: 1px solid;
    border-color: @orange; /* Bordino arancione per incorniciare la selezione */
}

/* Icona dell'elemento */
element-icon {
    size: 32px; /* Icone più grandi e visibili */
    vertical-align: 0.5;
}

/* Testo dell'elemento */
element-text {
    vertical-align: 0.5;
    text-color: inherit;
    /* Evidenziazione delle lettere che digiti in Rosso Gruvbox */
    highlight: bold #ea6962; 
}
