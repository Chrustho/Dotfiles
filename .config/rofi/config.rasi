@import "colors.rasi"

configuration {
    modi: "drun,run";
    font: "IosevkaTerm Nerd Font 14";
    show-icons: true;
    icon-theme: "Neuwaita";

    display-drun: " ";
    display-run: " ";
    drun-display-format: "{name}";

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: @fg-light;
}

window {
    transparency: "real";
    fullscreen: true;

    background-color: @window-bg;

    border: 0px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    children: [ dummy, wrapper, dummy ];
}

dummy {
    expand: true;
}

wrapper {
    orientation: vertical;
    expand: false;

    margin: 0px calc(50% - 375px);

    background-color: @base-bg;
    border: 4px solid;
    border-color: @orange;
    border-radius: 0px;
    padding: 0px;

    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    padding: 20px 25px;
    spacing: 15px;
    border-bottom: 2px solid;
    border-color: @base-bg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @blue;
    font: "IosevkaTerm Nerd Font Bold 16";
    vertical-align: 0.5;
}

entry {
    placeholder: "Cerca un'applicazione...";
    placeholder-color: @muted;
    text-color: @fg-light;
    vertical-align: 0.5;
    font: "IosevkaTerm Nerd Font 14";
}

listview {
    background-color: @bg;
    padding: 15px;
    columns: 2;
    lines: 7;
    spacing: 10px;
    scrollbar: false;
    fixed-height: true;
}

element {
    padding: 10px 15px;
    spacing: 15px;
    border-radius: 0px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

element selected.normal, element selected.active {
    background-color: @bg-alt;
    text-color: @yellow;
    border: 2px solid;
    border-color: @orange;
}

element-icon {
    size: 32px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
}
