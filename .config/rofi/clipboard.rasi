
configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    bg:          #282828;
    bg-alt:      #32302f;
    base-bg:     #1d2021;
    fg-light:    #ddc7a1;
    orange:      #e78a4e; /* Colore accento per la clipboard */
    
    background-color: transparent;
    text-color: @fg-light;
    font: "IosevkaTerm Nerd Font 13";
}

window {
    transparency: "real";
    fullscreen: true;
    background-color: #1d2021a6; 
    border: 0px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    children: [ dummy, wrapper, dummy ];
}

dummy {
    expand: true;
}

wrapper {
    orientation: vertical;
    expand: false;
    
    margin: 0px calc(50% - 425px);
    
    background-color: @base-bg;
    border: 4px solid;
    border-color: @orange; 
    border-radius: 0px;
    padding: 0px;
    
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    padding: 15px 20px;
    spacing: 15px;
    border-bottom: 2px solid;
    border-color: @base-bg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @orange;
    font: "IosevkaTerm Nerd Font Bold 16"; 
    vertical-align: 0.5;
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Cerca negli appunti...";
    placeholder-color: #7c6f64;
    text-color: @fg-light;
    vertical-align: 0.5;
}

listview {
    columns: 1; 
    lines: 10;  
    spacing: 4px;
    padding: 10px;
    scrollbar: true;
}

scrollbar {
    handle-width: 4px;
    handle-color: @orange;
    border-radius: 4px;
    background-color: @bg-alt;
}

element {
    padding: 10px 15px;
    border-radius: 6px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

element selected.normal, element selected.active {
    background-color: @bg-alt;
    text-color: @orange;
    border: 1px solid;
    border-color: @orange;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold #e78a4e; 
}
