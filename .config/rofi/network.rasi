/* =========================================================
   Tema Rofi - NetworkManager dmenu (Completo e Corretto)
   Stile: Gruvbox Material Moderno (Overlay)
   ========================================================= */

* {
    /* --- Palette Gruvbox Material --- */
    bg:          #282828; 
    bg-alt:      #32302f; 
    base-bg:     #1d2021; 
    fg-light:    #ddc7a1; 
    fg-dark:     #282828; 
    
    /* Accenti */
    red:         #ea6962;
    orange:      #e78a4e;
    yellow:      #d8a657;
    green:       #a9b665;
    aqua:        #89b482;
    blue:        #7daea3;
    purple:      #d3869b;

    background-color: transparent;
    text-color:       @fg-light;
    font:             "IosevkaTerm Nerd Font 14"; 
}

/* --- Finestra a Schermo Intero (Effetto Sfondo Scuro) --- */
window {
    transparency:     "real";
    fullscreen:       true;
    background-color: #1d2021a6; /* a6 = ~65% opacità */
    border:           0px;
    padding:          0px;
}

/* --- Contenitore Principale --- */
mainbox {
    background-color: transparent;
    /* I dummy spingono il wrapper al centro dello schermo */
    children:         [ dummy, wrapper, dummy ];
}

dummy {
    expand:           true;
}

/* --- Il vero box del gestore di rete --- */
wrapper {
    orientation:      vertical;
    expand:           false;
    
    /* Centra orizzontalmente: larghezza totale di circa 500px */
    margin:           0px calc(50% - 250px);
    
    background-color: @base-bg;
    border:           4px solid;
    border-color:     @orange; 
    border-radius:    0px;   
    padding:          0px;
    
    /* Il message serve a dmenu per gli avvisi (es. Password errata) */
    children:         [ inputbar, message, listview ];
}

/* --- Barra di Ricerca (Header) --- */
inputbar {
    background-color: @bg-alt;
    padding:          20px 25px;
    spacing:          15px;
    border-bottom:    2px solid;
    border-color:     @base-bg;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @blue; 
    font:             "IosevkaTerm Nerd Font Bold 16";
    vertical-align:   0.5;
}

entry {
    placeholder:       "Cerca rete..."; 
    placeholder-color: #7c6f64; 
    text-color:        @fg-light;
    vertical-align:    0.5;
    font:              "IosevkaTerm Nerd Font 14";
}

/* --- Box dei messaggi (es. "Connessione fallita") --- */
message {
    background-color: @bg-alt;
    padding:          10px 25px;
}

textbox {
    text-color:       @yellow;
}

/* --- Lista dei Risultati (Reti) --- */
listview {
    background-color: @bg;
    padding:          15px;
    columns:          1; 
    lines:            8; /* Fissa l'altezza per evitare che collassi a zero */
    spacing:          5px;
    scrollbar:        false;
    fixed-height:     true; /* FONDAMENTALE PER NON FAR SPARIRE LE RETI */
}

/* --- Singolo Elemento (Rete/Risultato) --- */
element {
    padding:          8px 15px;
    spacing:          10px;
    border-radius:    0px;
}

/* Stato Normale */
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @fg-light;
}

/* Stato Selezionato */
element selected.normal, element selected.active {
    background-color: @bg-alt;
    text-color:       @yellow; 
    border:           1px solid;
    border-color:     @orange; 
}

element-icon {
    size:             0px;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
    highlight:        bold #ea6962; 
}
