@import "colors.rasi"

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: @fg-light;
    font: "IosevkaTerm Nerd Font 14";
}

window {
    transparency: "real";
    fullscreen: true;
    background-color: @window-bg;
    border: 0px;
    padding: 0px;
}

mainbox {
    children: [ dummy, listview, dummy ];
}

dummy {
    expand: true;
}

listview {
    expand: false;
    columns: 1;
    lines: 5;

    margin: 0px 38%;
    padding: 15px;

    background-color: @bg;
    border: 4px solid;
    border-color: @red;
    border-radius: 0px;

    spacing: 8px;
    scrollbar: false;
    fixed-height: true;
}

element {
    padding: 12px 15px;
    border-radius: 0px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

element selected.normal, element selected.active {
    background-color: @bg-alt;
    text-color: @red;
    border: 3px solid;
    border-color: @red;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    text-color: inherit;
}
