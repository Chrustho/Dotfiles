/* Rofi: selettore wallpaper a griglia con anteprime */

@import "colors.rasi"

configuration {
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: @fg-light;
    font: "IosevkaTerm Nerd Font 12";
}

window {
    transparency: "real";
    fullscreen: true;
    background-color: @window-bg;
    border: 0px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    children: [ dummy, wrapper, dummy ];
}

dummy { expand: true; }

wrapper {
    orientation: vertical;
    expand: false;
    margin: 0px calc(50% - 600px);
    background-color: @base-bg;
    border: 3px solid;
    border-color: @accent;
    padding: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    padding: 14px 20px;
    spacing: 14px;
    border: 0px 0px 2px 0px solid;
    border-color: @base-bg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "IosevkaTerm Nerd Font Bold 15";
    vertical-align: 0.5;
}

entry {
    placeholder: "Filtra sfondi...";
    placeholder-color: @muted;
    vertical-align: 0.5;
}

listview {
    columns: 4;
    lines: 3;
    spacing: 14px;
    padding: 18px;
    scrollbar: true;
    fixed-height: true;
}

scrollbar {
    handle-width: 4px;
    handle-color: @accent;
    background-color: @bg-alt;
}

element {
    orientation: vertical;
    padding: 8px;
    spacing: 8px;
    border-radius: 8px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-light;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @accent;
    border: 2px solid;
    border-color: @accent;
}

element-icon {
    size: 9em;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
}
