// Niri: tema editorial

layout {
    background-color "transparent"

    border {
        off
    }

    focus-ring {
        on
        width 3
        active-gradient from="#C2603D" to="#B0735A" angle=135 in="oklch shorter hue"
        inactive-color "#C9C2B5"
        urgent-color "#B5564F"
    }

    shadow {
        on
        softness 28
        spread 2
        offset x=0 y=5
        color "#2A272433"
        inactive-color "transparent"
    }
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

animations {
    window-open {
        duration-ms 350
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 350
        curve "ease-out-cubic"
    }
}
