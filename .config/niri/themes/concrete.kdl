// Niri: tema concrete

layout {
    background-color "transparent"

    focus-ring {
        off
    }

    border {
        on
        width 4
        active-color "#FF5A1F"
        inactive-color "#3A3A38"
        urgent-color "#FF5A1F"
    }

    shadow {
        on
        softness 0
        spread 0
        offset x=6 y=6
        color "#000000FF"
        inactive-color "#00000080"
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

animations {
    window-open {
        duration-ms 130
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 130
        curve "ease-out-quad"
    }
}
