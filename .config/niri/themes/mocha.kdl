// === Tema: Mocha / Scuro soft cozy ===
// Dark ma morbido: toni espresso/mocha caldi, accento caramello/ambra,
// focus-ring morbido, angoli arrotondati, ombra soffusa.
// NB: i gaps (36) li applica niri-theme.sh sul config base.

layout {
    background-color "transparent"

    border {
        off
    }

    focus-ring {
        on
        width 3
        active-gradient from="#D9B99B" to="#C98B5E" angle=135 in="oklch shorter hue"
        inactive-color "#4A4038"
        urgent-color "#C56B5A"
    }

    shadow {
        on
        softness 32
        spread 3
        offset x=0 y=6
        color "#0E0A0866"           // ombra calda soffusa
        inactive-color "transparent"
    }
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

animations {
    window-open {
        duration-ms 350
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 350
        curve "ease-out-cubic"
    }
}
