// === Tema: Dune ===
// Deserto sci-fi: spice gold + spice-blue (occhi Fremen) su sabbia scura, ombra calda.
// NB: la geometria (gaps 37.5 ecc.) resta nel config.kdl base e NON viene toccata qui.

layout {
    background-color "transparent"

    border {
        off
    }

    focus-ring {
        on
        width 2
        active-gradient from="#d99a4e" to="#5aa9e6" angle=135 in="oklch shorter hue"
        inactive-color "#5a4a35"
        urgent-color "#a8472a"
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=5
        color "#0a07038c"
        inactive-color "transparent"
    }
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

animations {
    window-open {
        duration-ms 380
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 250
        curve "ease-out-quad"
    }
}
