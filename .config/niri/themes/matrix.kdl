// Niri: tema matrix

layout {
    background-color "transparent"

    border {
        off
    }

    focus-ring {
        on
        width 2
        active-gradient from="#00ff41" to="#008f11" angle=90
        inactive-color "#0a3f1a"
        urgent-color "#ff3131"
    }

    shadow {
        on
        draw-behind-window true
        softness 40
        spread 6
        offset x=0 y=0
        color "#00ff4130"
        inactive-color "#00ff4110"
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

animations {
    window-open {
        duration-ms 700
        curve "ease-out-quad"
        custom-shader r#"
        float rand(vec2 co){
            return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
        }

        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) {
                return vec4(0.0);
            }

            float progress = niri_clamped_progress;
            float inv = 1.0 - progress;
            vec3 coords_tex = niri_geo_to_tex * coords_geo;
            vec4 tex = texture2D(niri_tex, coords_tex.st);

            // colonne verticali a velocita' casuale (code rain)
            float col_id = floor(coords_geo.x * 40.0);
            float col_rand = rand(vec2(col_id, 1.0));
            float speed = mix(0.6, 1.4, col_rand);
            float head = progress * speed * 1.3;
            float revealed = smoothstep(head + 0.02, head - 0.02, coords_geo.y);

            // contenuto verde fosforo che si risolve verso i colori reali
            float gray = dot(tex.rgb, vec3(0.299, 0.587, 0.114));
            vec3 green = vec3(0.0, 1.0, 0.255);
            vec3 col = mix(green * (0.4 + gray), tex.rgb, progress);

            // testa di caduta luminosa
            float dist = abs(coords_geo.y - head);
            float headGlow = smoothstep(0.04, 0.0, dist) * inv;
            col += vec3(0.6, 1.0, 0.7) * headGlow;

            // glitch digitale
            float n = rand(vec2(col_id, floor(coords_geo.y * 60.0) + floor(progress * 30.0)));
            col += green * (n - 0.5) * 0.25 * inv;

            float a = tex.a * revealed;
            return vec4(col, 1.0) * a;
        }
        "#
    }

    window-close {
        duration-ms 250
        curve "ease-out-quad"
    }
}
