// Configurazione Fastfetch

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "$(find ~/.config/fastfetch/sprites -name '*.txt' | shuf -n 1)",
        "padding": {
            "top": 5,
            "right": 5,
            "left": 5
        }
    },
    "display": {
        "separator": " -> "
    },
    "modules": [
        "break",
        "title",
        "separator",
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#E6C384",
            "format": "{2}"
        },
        {
            "type": "os",
            "key": "├{icon}",
            "keyColor": "#E6C384"
        },
        {
            "type": "kernel",
            "key": "├",
            "keyColor": "#E6C384"
        },
        {
            "type": "packages",
            "key": "├󰏖",
            "keyColor": "#E6C384"
        },
        {
            "type": "shell",
            "key": "└",
            "keyColor": "#E6C384"
        },
        "break",

        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "#7E9CD8"
        },
        {
            "type": "lm",
            "key": "├󰧨",
            "keyColor": "#7E9CD8"
        },
        {
            "type": "wmtheme",
            "key": "├󰉼",
            "keyColor": "#7E9CD8"
        },
        {
            "type": "icons",
            "key": "├󰀻",
            "keyColor": "#7E9CD8"
        },
        {
            "type": "terminal",
            "key": "├",
            "keyColor": "#7E9CD8"
        },
        {
            "type": "wallpaper",
            "key": "└󰸉",
            "keyColor": "#7E9CD8"
        },

        "break",
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "#98BB6C"
        },
        {
            "type": "cpu",
            "key": "├󰻠",
            "keyColor": "#98BB6C"
        },
        {
            "type": "gpu",
            "key": "├󰍛",
            "keyColor": "#98BB6C"
        },
        {
            "type": "disk",
            "key": "├",
            "keyColor": "#98BB6C"
        },
        {
            "type": "memory",
            "key": "├󰑭",
            "keyColor": "#98BB6C"
        },
        {
            "type": "swap",
            "key": "├󰓡",
            "keyColor": "#98BB6C"
        },
        {
            "type": "display",
            "key": "├󰍹",
            "keyColor": "#98BB6C"
        },
        {
            "type": "uptime",
            "key": "└󰅐",
            "keyColor": "#98BB6C"
        },

        "break"
    ]
}
