// Configurazione Waybar - layout BOTTOM (barra piena in basso, tutti i moduli)
// Da usare con themes/bottom.css.

{
    "layer": "top",
    "position": "bottom",
    "height": 39,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/launcher",
        "niri/workspaces",
        "custom/nightmode",
        "custom/mako",
        "custom/clipboard",
        "idle_inhibitor",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "backlight",
        "power-profiles-daemon",
        "network",
        "battery",
        "tray",
        "custom/power"
    ],

    "idle_inhibitor": {
        "format": " {icon} ",
        "format-icons": { "activated": "", "deactivated": "󰒲" },
        "tooltip-format-activated": "Caffeina Attiva: Lo schermo non si spegnerà",
        "tooltip-format-deactivated": "Caffeina Disattivata: Sospensione automatica in uso"
    },
    "custom/launcher": {
        "format": "  ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": { "active": "", "default": "" }
    },
    "niri/window": {
        "format": " {}",
        "max-length": 40,
        "icon": true,
        "icon-size": 18
    },
    "clock": {
        "interval": 1,
        "format": "  {:%H:%M:%S    %d/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/nightmode": {
        "format": "  ",
        "on-click": "pkill wlsunset || wlsunset -T 7500 &",
        "tooltip": false
    },
    "custom/clipboard": {
        "format": "  ",
        "on-click": "cliphist list | rofi -dmenu -i -p '' -theme ~/.config/rofi/clipboard.rasi | cliphist decode | wl-copy",
        "tooltip": false
    },
    "custom/mako": {
        "format": "  ",
        "on-click": "makoctl dismiss -a",
        "on-click-right": "makoctl restore",
        "tooltip": false
    },
    "cpu": {
        "interval": 2,
        "format": "   {usage}% ",
        "on-click": "ghostty -e btop"
    },
    "memory": {
        "interval": 2,
        "format": "   {percentage}% ",
        "on-click": "ghostty -e btop"
    },
    "pulseaudio": {
        "format": " {icon}  {volume}% ",
        "format-muted": "    Muted ",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },
    "backlight": {
        "format": " {icon}  {percent}% ",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": " {icon} ",
        "format-icons": { "default": "", "performance": "", "balanced": "", "power-saver": "" }
    },
    "network": {
        "format-wifi": "   {essid} ",
        "format-ethernet": "   {ipaddr} ",
        "format-disconnected": " ⚠ Offline ",
        "on-click": "ghostty -e nmtui"
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": " {icon} {capacity}% ",
        "format-charging": " 󰂄  {capacity}% ",
        "format-plugged": " 󰚥  {capacity}% ",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tray": {
        "spacing": 9
    },
    "custom/power": {
        "format": "   ",
        "on-click": "~/.local/bin/powermenu.sh",
        "tooltip": false
    }
}
